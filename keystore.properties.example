# ============================================================================
#  MODELO -- este arquivo E versionado; o keystore.properties NAO E.
# ----------------------------------------------------------------------------
#  Voce nao precisa preencher isto na mao. Rode:
#
#      build.bat keystore
#
#  e o script gera a chave (easypace.jks) e escreve o keystore.properties
#  de verdade para voce.
#
#  Se for fazer manualmente, copie este arquivo para "keystore.properties"
#  na raiz do projeto e preencha os quatro campos. Use barras normais (/)
#  no caminho, e nao contrabarras: arquivos .properties tratam "\" como
#  caractere de escape.
# ============================================================================

storeFile=C:/caminho/para/easypace.jks
storePassword=SUA_SENHA
keyAlias=easypace
keyPassword=SUA_SENHA
